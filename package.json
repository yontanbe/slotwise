{
  "name": "slotwise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:sql": "node supabase/check-schema.mjs",
    "test:e2e": "playwright test --trace off",
    "preview:cloudflare": "wrangler pages dev dist --port 8788",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name=slotwise",
    "test:e2e:cf": "npm run build && playwright test -c playwright.cf.config.ts --trace off --project=desktop",
    "setup:supabase": "bash scripts/setup-supabase.sh"
  },
  "dependencies": {
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-hebrew": "^5.3.0",
    "@hebcal/core": "^6.14.7",
    "@supabase/supabase-js": "^2.119.0",
    "luxon": "^3.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.63.0",
    "@types/luxon": "^3.7.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^4.158.0"
  }
}
