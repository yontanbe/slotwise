# Copy to .env.supabase (git-ignored) and run: bash scripts/setup-supabase.sh
# Lines starting with SUPABASE_ are used by the script only; everything else is sent to
# `supabase secrets set` for the Edge Functions (see docs/SERVER.md section 2). Empty values are skipped.

# --- used by the script ---
SUPABASE_PROJECT_REF=          # Dashboard > Project Settings > General > Project ID (20 letters)
SUPABASE_DB_PASSWORD=          # the database password chosen when the project was created
SUPABASE_SERVICE_ROLE_KEY=     # Project Settings > API Keys > service_role (stored in Vault for pg_cron)

# --- Edge Function secrets ---
APP_URL=https://slotwise.pages.dev/
DB_WEBHOOK_SECRET=             # leave empty to let the script generate one
RESEND_API_KEY=
RESEND_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_HAS_BUTTONS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WORKFLOW_WEBHOOK_SECRET=
API_RATE_LIMIT_PER_MIN=
